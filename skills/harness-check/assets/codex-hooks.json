{
  "_comment": "template; run-child resolves __SKILL__ and writes a run-local copy",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 __SKILL__/assets/hook-gate.py mark SessionStart"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 __SKILL__/assets/hook-gate.py mark SessionEnd"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "python3 __SKILL__/assets/hook-gate.py mark PreToolUse"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "python3 __SKILL__/assets/hook-gate.py mark PostToolUse"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 __SKILL__/assets/hook-gate.py mark UserPromptSubmit"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 __SKILL__/assets/hook-gate.py mark Stop"
          }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 __SKILL__/assets/hook-gate.py mark PermissionRequest"
          }
        ]
      }
    ]
  }
}
